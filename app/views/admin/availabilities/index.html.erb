<% content_for :page_title, "Disponibilidade — #{@professional.name}" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white">Disponibilidade Semanal de <%= @professional.name %></h2>
      <p class="text-xs text-slate-400">Configure os horários de início e término em cada dia da semana.</p>
    </div>
    <%= link_to "← Voltar ao Profissional", admin_professional_path(tenant_slug: current_tenant.slug, id: @professional.id), class: "text-xs font-semibold text-slate-400 hover:text-white transition" %>
  </div>

  <!-- Add New Availability Form -->
  <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
    <h3 class="text-sm font-bold text-white mb-4">Adicionar Horário de Atendimento</h3>

    <%= form_with(model: [:admin, @professional, @availability], url: admin_professional_availabilities_path(tenant_slug: current_tenant.slug, professional_id: @professional.id), class: "space-y-4") do |f| %>
      <% if @availability&.errors&.any? %>
        <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs">
          <%= @availability.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :day_of_week, "Dia da semana", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.select :day_of_week, Availability::DAYS.map { |k, v| [v, k] }, {}, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= f.label :start_time, "Horário Inicial", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.time_field :start_time, required: true, value: "09:00", class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= f.label :end_time, "Horário Final", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.time_field :end_time, required: true, value: "18:00", class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>
      </div>

      <div class="flex justify-end pt-2">
        <%= f.submit "Adicionar Horário", class: "px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Weekly Table -->
  <div class="p-6 rounded-3xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-xl">
    <h3 class="text-sm font-bold text-white mb-4">Grade de Atendimento Atual</h3>

    <div class="space-y-3">
      <% (0..6).each do |day_idx| %>
        <% day_availabilities = @availabilities.select { |a| a.day_of_week == day_idx } %>
        <div class="p-4 rounded-2xl bg-slate-950/50 border border-slate-800/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 flex items-center justify-center text-xs font-bold shrink-0">
              <%= Availability::DAYS[day_idx].first(3) %>
            </span>
            <div>
              <p class="text-xs font-bold text-white"><%= Availability::DAYS[day_idx] %></p>
              <% if day_availabilities.any? %>
                <div class="flex flex-wrap gap-2 mt-1">
                  <% day_availabilities.each do |avail| %>
                    <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-xs">
                      <span><%= avail.time_range %></span>
                      <%= button_to admin_professional_availability_path(tenant_slug: current_tenant.slug, professional_id: @professional.id, id: avail.id), method: :delete, data: { turbo_confirm: "Remover este horário?" }, class: "text-slate-400 hover:text-rose-400 transition", title: "Excluir" do %>
                        ✕
                      <% end %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-xs text-slate-500 italic">Nenhum horário cadastrado (Folga)</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
