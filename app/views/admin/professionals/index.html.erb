<% content_for :page_title, "Equipe & Profissionais" %>

<div class="space-y-6">
  <!-- Header with Actions -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white">Profissionais Cadastrados</h2>
      <p class="text-xs text-slate-400 mt-0.5">Gerencie os profissionais que atendem seus clientes e seus horários de atendimento.</p>
    </div>
    <%= link_to new_admin_professional_path(tenant_slug: current_tenant.slug), class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition transform hover:-translate-y-0.5" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Novo Profissional
    <% end %>
  </div>

  <!-- Professionals Grid -->
  <% if @professionals.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @professionals.each do |professional| %>
        <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl flex flex-col justify-between hover:border-slate-700 transition">
          <div>
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center font-bold text-lg text-white shadow-md">
                  <%= professional.name.first.upcase %>
                </div>
                <div>
                  <h3 class="text-base font-bold text-white leading-snug"><%= professional.name %></h3>
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-medium <%= professional.active? ? 'text-emerald-400' : 'text-slate-500' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= professional.active? ? 'bg-emerald-400' : 'bg-slate-600' %>"></span>
                    <%= professional.active? ? "Ativo" : "Inativo" %>
                  </span>
                </div>
              </div>

              <div class="flex items-center gap-1">
                <%= link_to edit_admin_professional_path(tenant_slug: current_tenant.slug, id: professional.id), class: "p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition", title: "Editar" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                <% end %>
                <%= button_to admin_professional_path(tenant_slug: current_tenant.slug, id: professional.id), method: :delete, data: { turbo_confirm: "Tem certeza que deseja remover este profissional?" }, class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-slate-800 transition", title: "Remover" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                <% end %>
              </div>
            </div>

            <% if professional.bio.present? %>
              <p class="text-xs text-slate-400 line-clamp-2 mb-4"><%= professional.bio %></p>
            <% end %>

            <div class="space-y-1.5 text-xs text-slate-300 pt-2 border-t border-slate-800/80 mb-4">
              <% if professional.email.present? %>
                <div class="flex items-center gap-2 text-slate-400">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span class="truncate"><%= professional.email %></span>
                </div>
              <% end %>
              <% if professional.phone.present? %>
                <div class="flex items-center gap-2 text-slate-400">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span><%= professional.phone %></span>
                </div>
              <% end %>
              <div class="flex items-center gap-2 text-slate-400">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Intervalo entre atendimentos: <strong><%= professional.buffer_minutes %> min</strong></span>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 mb-4">
              <% professional.services.active.each do |service| %>
                <span class="text-[10px] font-medium bg-slate-800 text-indigo-300 px-2 py-0.5 rounded-md border border-slate-700/50">
                  <%= service.name %>
                </span>
              <% end %>
              <% if professional.services.none? %>
                <span class="text-[11px] text-slate-500 italic">Nenhum serviço vinculado</span>
              <% end %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-800/80">
            <%= link_to admin_professional_availabilities_path(tenant_slug: current_tenant.slug, professional_id: professional.id), class: "py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 text-center transition" do %>
              Horários
            <% end %>
            <%= link_to admin_professional_time_blocks_path(tenant_slug: current_tenant.slug, professional_id: professional.id), class: "py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 text-center transition" do %>
              Bloqueios
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-12 rounded-3xl bg-slate-900/40 border border-slate-800/80 text-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Nenhum profissional cadastrado</h3>
      <p class="text-sm text-slate-400 max-w-sm mx-auto">Cadastre o primeiro profissional para habilitar agendamentos na sua empresa.</p>
      <%= link_to new_admin_professional_path(tenant_slug: current_tenant.slug), class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition" do %>
        Cadastrar Primeiro Profissional
      <% end %>
    </div>
  <% end %>
</div>
