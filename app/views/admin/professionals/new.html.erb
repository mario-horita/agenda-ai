<% content_for :page_title, "Novo Profissional" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white">Cadastrar Profissional</h2>
      <p class="text-xs text-slate-400">Preencha os dados abaixo para adicionar um membro à sua equipe.</p>
    </div>
    <%= link_to "← Voltar", admin_professionals_path(tenant_slug: current_tenant.slug), class: "text-xs font-semibold text-slate-400 hover:text-white transition" %>
  </div>

  <div class="p-8 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl">
    <%= render "form", professional: @professional, services: @services %>
  </div>
</div>
