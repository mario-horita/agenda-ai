<% content_for :page_title, @professional.name %>

<div class="space-y-6">
  <!-- Profile Header -->
  <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center font-extrabold text-2xl text-white shadow-xl shrink-0">
        <%= @professional.name.first.upcase %>
      </div>
      <div>
        <div class="flex items-center gap-3 justify-center sm:justify-start">
          <h2 class="text-2xl font-bold text-white"><%= @professional.name %></h2>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-0.5 rounded-full <%= @professional.active? ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-slate-800 text-slate-500' %>">
            <%= @professional.active? ? "Ativo" : "Inativo" %>
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1"><%= @professional.email || "Sem email cadastrado" %> • <%= @professional.phone || "Sem telefone" %></p>
        <% if @professional.bio.present? %>
          <p class="text-xs text-slate-300 mt-2 max-w-xl"><%= @professional.bio %></p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <%= link_to edit_admin_professional_path(tenant_slug: current_tenant.slug, id: @professional.id), class: "px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition" do %>
        Editar Dados
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Weekly Availabilities Card -->
    <div class="p-6 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-base font-bold text-white">Disponibilidade Semanal</h3>
            <p class="text-xs text-slate-400">Horários regulares de atendimento</p>
          </div>
          <%= link_to admin_professional_availabilities_path(tenant_slug: current_tenant.slug, professional_id: @professional.id), class: "text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition" do %>
            Gerenciar Horários →
          <% end %>
        </div>

        <div class="space-y-2">
          <% (0..6).each do |day_idx| %>
            <% day_availabilities = @availabilities.select { |a| a.day_of_week == day_idx } %>
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-850/50 border border-slate-800/40 text-xs">
              <span class="font-medium text-slate-300"><%= Availability::DAYS[day_idx] %></span>
              <% if day_availabilities.any? %>
                <span class="font-semibold text-emerald-400">
                  <%= day_availabilities.map(&:time_range).join(", ") %>
                </span>
              <% else %>
                <span class="text-slate-500 italic">Folga</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Time Blocks Card -->
    <div class="p-6 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-base font-bold text-white">Bloqueios de Agenda</h3>
            <p class="text-xs text-slate-400">Férias, consultas ou folgas pontuais</p>
          </div>
          <%= link_to admin_professional_time_blocks_path(tenant_slug: current_tenant.slug, professional_id: @professional.id), class: "text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition" do %>
            Gerenciar Bloqueios →
          <% end %>
        </div>

        <% if @time_blocks.any? %>
          <div class="space-y-2 max-h-80 overflow-y-auto">
            <% @time_blocks.each do |block| %>
              <div class="p-3 rounded-xl bg-rose-500/5 border border-rose-500/15 text-xs flex items-center justify-between">
                <div>
                  <p class="font-semibold text-rose-300"><%= block.reason %></p>
                  <p class="text-slate-400 text-[11px]"><%= block.formatted_period %></p>
                </div>
                <span class="text-[10px] uppercase font-bold text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded">Bloqueado</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-slate-500 italic py-8 text-center">Nenhum bloqueio registrado.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
