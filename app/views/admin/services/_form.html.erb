<%= form_with(model: [:admin, service], url: service.persisted? ? admin_service_path(tenant_slug: current_tenant.slug, id: service.id) : admin_services_path(tenant_slug: current_tenant.slug), class: "space-y-6") do |f| %>
  <% if service.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm space-y-1">
      <p class="font-bold">Corrija os seguintes erros:</p>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <%= f.label :name, "Nome do serviço *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :name, required: true, class: "w-full px-4 py-2.5 bg-slate-900 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white placeholder-slate-500 text-sm outline-none", placeholder: "Ex: Corte de Cabelo Degradê" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :duration_minutes, "Duração (minutos) *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :duration_minutes, min: 5, step: 5, required: true, class: "w-full px-4 py-2.5 bg-slate-900 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white text-sm outline-none" %>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Preço (R$) *</label>
          <%= number_field_tag "service[price_in_reais]", (service.price_cents ? service.price_in_reais : 0), min: 0, step: 0.50, required: true, class: "w-full px-4 py-2.5 bg-slate-900 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white text-sm outline-none" %>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <%= f.check_box :active, class: "h-4 w-4 rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-950" %>
        <%= f.label :active, "Serviço ativo para agendamento online", class: "text-sm text-slate-300" %>
      </div>
    </div>

    <div class="space-y-4">
      <div>
        <%= f.label :description, "Descrição", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
        <%= f.text_area :description, rows: 3, class: "w-full px-4 py-2.5 bg-slate-900 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white placeholder-slate-500 text-sm outline-none", placeholder: "Detalhes sobre o que está incluso no serviço..." %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Profissionais que realizam este serviço</label>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2.5 max-h-48 overflow-y-auto">
          <% if professionals.any? %>
            <% professionals.each do |prof| %>
              <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-slate-800/60 transition cursor-pointer">
                <%= check_box_tag "service[professional_ids][]", prof.id, service.professional_ids.include?(prof.id), id: "prof_#{prof.id}", class: "h-4 w-4 rounded border-slate-700 bg-slate-800 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900" %>
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-medium text-white block truncate"><%= prof.name %></span>
                  <span class="text-[11px] text-slate-400 block"><%= prof.email %></span>
                </div>
              </label>
            <% end %>
          <% else %>
            <p class="text-xs text-slate-500 italic">Nenhum profissional cadastrado ainda.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800">
    <%= link_to "Cancelar", admin_services_path(tenant_slug: current_tenant.slug), class: "px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 transition" %>
    <%= f.submit service.persisted? ? "Salvar Alterações" : "Cadastrar Serviço", class: "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition cursor-pointer" %>
  </div>
<% end %>
