<% content_for :page_title, "Catálogo de Serviços" %>

<div class="space-y-6">
  <!-- Header with Actions -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white">Serviços Oferecidos</h2>
      <p class="text-xs text-slate-400 mt-0.5">Defina os serviços, durações, preços e quais profissionais estão habilitados a realizá-los.</p>
    </div>
    <%= link_to new_admin_service_path(tenant_slug: current_tenant.slug), class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition transform hover:-translate-y-0.5" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Novo Serviço
    <% end %>
  </div>

  <!-- Services Grid -->
  <% if @services.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @services.each do |service| %>
        <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl flex flex-col justify-between hover:border-slate-700 transition">
          <div>
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <h3 class="text-base font-bold text-white leading-snug"><%= service.name %></h3>
                <span class="inline-flex items-center gap-1.5 text-[11px] font-medium <%= service.active? ? 'text-emerald-400' : 'text-slate-500' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= service.active? ? 'bg-emerald-400' : 'bg-slate-600' %>"></span>
                  <%= service.active? ? "Disponível" : "Inativo" %>
                </span>
              </div>

              <div class="flex items-center gap-1">
                <%= link_to edit_admin_service_path(tenant_slug: current_tenant.slug, id: service.id), class: "p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition", title: "Editar" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                <% end %>
                <%= button_to admin_service_path(tenant_slug: current_tenant.slug, id: service.id), method: :delete, data: { turbo_confirm: "Tem certeza que deseja remover este serviço?" }, class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-slate-800 transition", title: "Remover" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                <% end %>
              </div>
            </div>

            <% if service.description.present? %>
              <p class="text-xs text-slate-400 line-clamp-2 mb-4"><%= service.description %></p>
            <% end %>

            <div class="flex items-center justify-between py-3 px-4 rounded-xl bg-slate-950/60 border border-slate-800/80 mb-4">
              <div>
                <span class="text-[10px] uppercase font-semibold text-slate-400 block">Duração</span>
                <span class="text-sm font-bold text-white"><%= service.duration_minutes %> min</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] uppercase font-semibold text-slate-400 block">Preço</span>
                <span class="text-sm font-extrabold text-emerald-400"><%= service.formatted_price %></span>
              </div>
            </div>

            <div>
              <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-400 block mb-1.5">Profissionais habilitados</span>
              <div class="flex flex-wrap gap-1.5">
                <% service.professionals.active.each do |prof| %>
                  <span class="text-[10px] font-medium bg-indigo-500/10 text-indigo-300 px-2 py-0.5 rounded-md border border-indigo-500/20">
                    <%= prof.name %>
                  </span>
                <% end %>
                <% if service.professionals.none? %>
                  <span class="text-[11px] text-slate-500 italic">Nenhum profissional vinculado</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-12 rounded-3xl bg-slate-900/40 border border-slate-800/80 text-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Nenhum serviço cadastrado</h3>
      <p class="text-sm text-slate-400 max-w-sm mx-auto">Cadastre os serviços que sua equipe realiza para que os clientes possam agendar online.</p>
      <%= link_to new_admin_service_path(tenant_slug: current_tenant.slug), class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition" do %>
        Cadastrar Primeiro Serviço
      <% end %>
    </div>
  <% end %>
</div>
