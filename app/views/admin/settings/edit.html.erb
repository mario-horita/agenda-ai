<% content_for :page_title, "Configurações do Estabelecimento" %>

<div class="max-w-4xl mx-auto space-y-8">
  <div>
    <h2 class="text-xl font-bold text-white">Configurações & Políticas</h2>
    <p class="text-xs text-slate-400 mt-0.5">Gerencie os dados da sua empresa, políticas de agendamento e canais de notificação.</p>
  </div>

  <%= form_with(url: admin_setting_path(tenant_slug: current_tenant.slug), method: :patch, class: "space-y-6") do |f| %>
    <!-- Business Profile Section -->
    <div class="p-6 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl space-y-4">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider">Identidade & Contato</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= label_tag "tenant[name]", "Nome do Estabelecimento *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= text_field_tag "tenant[name]", @tenant.name, required: true, class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= label_tag "tenant[phone]", "Telefone / WhatsApp", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= text_field_tag "tenant[phone]", @tenant.phone, placeholder: "(11) 98765-4321", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= label_tag "tenant[primary_color]", "Cor Primária", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <div class="flex items-center gap-2">
            <%= color_field_tag "tenant[primary_color]", @tenant.primary_color, class: "w-10 h-10 rounded-xl bg-transparent border-0 cursor-pointer p-0" %>
            <%= text_field_tag "tenant[primary_color]", @tenant.primary_color, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs font-mono outline-none" %>
          </div>
        </div>

        <div>
          <%= label_tag "tenant[secondary_color]", "Cor Secundária", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <div class="flex items-center gap-2">
            <%= color_field_tag "tenant[secondary_color]", @tenant.secondary_color, class: "w-10 h-10 rounded-xl bg-transparent border-0 cursor-pointer p-0" %>
            <%= text_field_tag "tenant[secondary_color]", @tenant.secondary_color, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs font-mono outline-none" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Booking Rules Section -->
    <div class="p-6 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl space-y-4">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider">Políticas de Agendamento</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= label_tag "tenant_setting[cancellation_window_hours]", "Janela Mínima de Cancelamento (Horas)", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= number_field_tag "tenant_setting[cancellation_window_hours]", @setting.cancellation_window_hours, min: 0, max: 72, class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
          <span class="text-[11px] text-slate-500 mt-1 block">Tempo limite antes do horário para o cliente cancelar.</span>
        </div>

        <div>
          <%= label_tag "tenant_setting[reminder_hours]", "Antecedência do Lembrete (Horas)", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= number_field_tag "tenant_setting[reminder_hours]", @setting.reminder_hours, min: 1, max: 48, class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
          <span class="text-[11px] text-slate-500 mt-1 block">Padrão: 24 horas antes do atendimento.</span>
        </div>
      </div>

      <div class="pt-2">
        <label class="flex items-center gap-3 cursor-pointer">
          <%= hidden_field_tag "tenant_setting[allow_reschedule]", "0" %>
          <%= check_box_tag "tenant_setting[allow_reschedule]", "1", @setting.allow_reschedule?, class: "w-4 h-4 rounded text-indigo-600 bg-slate-950 border-slate-800 focus:ring-0 focus:outline-none" %>
          <span class="text-xs text-slate-300 font-semibold">Permitir que clientes reagendem horários online</span>
        </label>
      </div>
    </div>

    <!-- Notification Channels Section -->
    <div class="p-6 rounded-3xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-xl space-y-4">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider">Canais de Notificação</h3>
      <p class="text-xs text-slate-400">Escolha por onde seus clientes receberão avisos e lembretes:</p>

      <div class="space-y-3 pt-2">
        <label class="flex items-center gap-3 cursor-pointer">
          <%= check_box_tag "tenant_setting[notification_channels][]", "email", @setting.notification_channels_array.include?("email"), class: "w-4 h-4 rounded text-indigo-600 bg-slate-950 border-slate-800 focus:ring-0" %>
          <div>
            <span class="text-xs text-white font-bold block">Email Transacional</span>
            <span class="text-[11px] text-slate-400">Confirmações e lembretes automáticos por email</span>
          </div>
        </label>

        <label class="flex items-center gap-3 cursor-pointer">
          <%= check_box_tag "tenant_setting[notification_channels][]", "whatsapp", @setting.notification_channels_array.include?("whatsapp"), class: "w-4 h-4 rounded text-indigo-600 bg-slate-950 border-slate-800 focus:ring-0" %>
          <div>
            <span class="text-xs text-white font-bold block">WhatsApp (Evolution API / Twilio)</span>
            <span class="text-[11px] text-slate-400">Notificações e lembretes instantâneos no WhatsApp</span>
          </div>
        </label>
      </div>
    </div>

    <div class="pt-2">
      <%= f.submit "Salvar Alterações", class: "px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-indigo-600/30 transition cursor-pointer" %>
    </div>
  <% end %>
</div>
