<% content_for :page_title, "Planos & Assinatura" %>

<div class="max-w-6xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-extrabold text-white">Planos & Assinatura</h2>
      <p class="text-xs text-slate-400 mt-0.5">Gerencie seu plano no Agenda AI e acesse faturas via Stripe.</p>
    </div>

    <% if @tenant.stripe_customer_id.present? %>
      <%= button_to portal_admin_subscription_path(tenant_slug: @tenant.slug), method: :post, class: "flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 border border-slate-700 transition cursor-pointer" do %>
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
        Portal de Faturas Stripe →
      <% end %>
    <% end %>
  </div>

  <!-- Current Status Banner -->
  <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-extrabold text-lg shrink-0">
        💎
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-base font-bold text-white">
            Plano <%= @tenant.plan_details[:name] %>
          </h3>
          <% if @tenant.subscribed? %>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase">
              Assinatura Ativa
            </span>
          <% elsif @tenant.on_trial? %>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 uppercase">
              Período de Testes
            </span>
          <% else %>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase">
              <%= @tenant.subscription_status.capitalize %>
            </span>
          <% end %>
        </div>
        <p class="text-xs text-slate-400 mt-0.5">
          <% if @tenant.on_trial? %>
            Você tem <strong><%= @tenant.trial_days_left %> dias restantes</strong> de teste gratuito com todos os recursos.
          <% elsif @tenant.subscribed? %>
            Próxima renovação automática gerenciada de forma segura pelo Stripe.
          <% else %>
            Escolha um dos planos abaixo para reativar seu acesso completo.
          <% end %>
        </p>
      </div>
    </div>

    <div class="text-right">
      <span class="text-xs text-slate-400 block">Capacidade</span>
      <strong class="text-sm text-white">Até <%= @tenant.max_professionals %> <%= 'profissional'.pluralize(@tenant.max_professionals) %></strong>
    </div>
  </div>

  <!-- Pricing Table Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @plans.each do |key, plan| %>
      <% is_current = @tenant.plan == key && @tenant.subscribed? %>
      <% is_pro = key == "pro" %>

      <div class="p-6 rounded-3xl border transition relative flex flex-col justify-between <%= is_pro ? 'bg-slate-900/90 border-indigo-500/60 shadow-2xl shadow-indigo-500/10' : 'bg-slate-900/50 border-slate-800/80 hover:border-slate-700' %>">
        <% if is_pro %>
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold text-[10px] uppercase tracking-wider shadow-md">
            Mais Popular
          </div>
        <% end %>

        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-bold text-white"><%= plan[:name] %></h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="text-3xl font-extrabold text-white">R$ <%= plan[:price_reais].round %></span>
              <span class="text-xs text-slate-400">/mês</span>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-800/80 space-y-2.5">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 block">O que está incluído:</span>
            <ul class="space-y-2 text-xs text-slate-300">
              <% plan[:features].each do |feat| %>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span><%= feat %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-800/60">
          <% if is_current %>
            <button disabled class="w-full py-3 px-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold text-xs uppercase tracking-wider text-center cursor-default">
              ✓ Seu Plano Atual
            </button>
          <% else %>
            <%= button_to admin_subscription_path(tenant_slug: @tenant.slug, plan: key), method: :post, class: "w-full py-3 px-4 rounded-xl #{is_pro ? 'bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white shadow-lg shadow-indigo-600/30' : 'bg-slate-800 hover:bg-slate-700 text-white'} font-bold text-xs uppercase tracking-wider transition transform hover:-translate-y-0.5 cursor-pointer text-center" do %>
              Assinar <%= plan[:name] %> →
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
