<% content_for :page_title, "Bloqueios — #{@professional.name}" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white">Bloqueios de Horário de <%= @professional.name %></h2>
      <p class="text-xs text-slate-400">Registre períodos em que o profissional não estará disponível (férias, consultas, folgas).</p>
    </div>
    <%= link_to "← Voltar ao Profissional", admin_professional_path(tenant_slug: current_tenant.slug, id: @professional.id), class: "text-xs font-semibold text-slate-400 hover:text-white transition" %>
  </div>

  <!-- Add New Time Block Form -->
  <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
    <h3 class="text-sm font-bold text-white mb-4">Novo Bloqueio de Agenda</h3>

    <%= form_with(model: [:admin, @professional, @time_block], url: admin_professional_time_blocks_path(tenant_slug: current_tenant.slug, professional_id: @professional.id), class: "space-y-4") do |f| %>
      <% if @time_block&.errors&.any? %>
        <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs">
          <%= @time_block.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :reason, "Motivo do bloqueio *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :reason, required: true, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none", placeholder: "Ex: Férias, Consulta Médica, Folga" %>
        </div>

        <div class="flex items-center gap-2 pt-6">
          <%= f.check_box :all_day, class: "h-4 w-4 rounded border-slate-700 bg-slate-950 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900" %>
          <%= f.label :all_day, "Bloquear o dia inteiro", class: "text-xs text-slate-300 font-medium" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <%= f.label :start_date, "Data Inicial *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :start_date, required: true, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= f.label :end_date, "Data Final *", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :end_date, required: true, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= f.label :start_time, "Horário Inicial", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.time_field :start_time, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= f.label :end_time, "Horário Final", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.time_field :end_time, class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>
      </div>

      <div class="flex justify-end pt-2">
        <%= f.submit "Salvar Bloqueio", class: "px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Time Blocks List -->
  <div class="p-6 rounded-3xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-xl">
    <h3 class="text-sm font-bold text-white mb-4">Bloqueios Cadastrados</h3>

    <% if @time_blocks.any? %>
      <div class="space-y-3">
        <% @time_blocks.each do |block| %>
          <div class="p-4 rounded-2xl bg-slate-950/50 border border-slate-800/60 flex items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-white"><%= block.reason %></span>
                <span class="text-[10px] uppercase font-bold text-rose-400 bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 rounded">
                  <%= block.all_day? ? "Dia todo" : "Horário parcial" %>
                </span>
              </div>
              <p class="text-xs text-slate-400 mt-1"><%= block.formatted_period %></p>
            </div>

            <%= button_to admin_professional_time_block_path(tenant_slug: current_tenant.slug, professional_id: @professional.id, id: block.id), method: :delete, data: { turbo_confirm: "Remover este bloqueio?" }, class: "p-2 rounded-xl text-slate-400 hover:text-rose-400 hover:bg-slate-900 transition", title: "Remover" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-slate-500 italic py-6 text-center">Nenhum bloqueio cadastrado para este profissional.</p>
    <% end %>
  </div>
</div>
