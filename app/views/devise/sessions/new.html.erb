<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-slate-900/60 p-8 sm:p-10 rounded-3xl border border-slate-800/80 backdrop-blur-xl shadow-2xl">
    <div class="text-center">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center font-extrabold text-white text-xl shadow-lg shadow-indigo-500/30 mx-auto mb-4">
        AI
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Entrar na sua conta</h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-400">Acesse o painel do seu estabelecimento</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, "Email profissional", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full px-4 py-3 bg-slate-950/70 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white placeholder-slate-500 text-sm transition outline-none", placeholder: "seu@email.com" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Senha", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider" %>
            <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
              <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs text-indigo-400 hover:text-indigo-300 transition" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full px-4 py-3 bg-slate-950/70 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl text-white placeholder-slate-500 text-sm transition outline-none", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "ml-2 block text-xs text-slate-300" %>
          </div>
        <% end %>
      </div>

      <div>
        <%= f.submit "Entrar no Painel", class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 transition transform hover:-translate-y-0.5 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-2">
      <%= link_to "← Voltar para a página inicial", root_path, class: "text-xs text-slate-400 hover:text-slate-200 transition" %>
    </div>
  </div>
</div>
