<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-950 text-slate-100 antialiased">
  <head>
    <title><%= content_for(:title) || (@tenant ? "Agendar em #{@tenant.name}" : "Agendamento Online") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      :root {
        --primary-color: <%= @tenant&.primary_color || "#6366f1" %>;
        --secondary-color: <%= @tenant&.secondary_color || "#8b5cf6" %>;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-slate-950 text-slate-100 selection:bg-indigo-500 selection:text-white">
    <!-- Top branding bar -->
    <header class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-xl sticky top-0 z-40">
      <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-white shadow-lg" style="background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));">
            <%= @tenant&.name&.first&.upcase || "A" %>
          </div>
          <div>
            <h1 class="text-base font-semibold text-white leading-tight"><%= @tenant&.name || "Agenda AI" %></h1>
            <p class="text-xs text-slate-400">Agendamento Online</p>
          </div>
        </div>

        <% if @tenant&.phone.present? %>
          <div class="text-xs text-slate-400 hidden sm:flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <%= @tenant.phone %>
          </div>
        <% end %>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 sm:p-6 md:p-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
      Desenvolvido com tecnologia <span class="font-semibold text-indigo-400">Agenda AI</span>
    </footer>
  </body>
</html>
