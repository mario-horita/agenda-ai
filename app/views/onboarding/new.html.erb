<% content_for :title, "Criar Conta — Agenda AI" %>

<div class="min-h-screen py-12 px-6 flex flex-col justify-center items-center">
  <!-- Brand Logo & Header -->
  <div class="text-center space-y-2 mb-8">
    <%= link_to root_path, class: "inline-flex items-center gap-3 group" do %>
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center font-extrabold text-white text-lg shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition transform">
        AI
      </div>
      <span class="text-2xl font-extrabold tracking-tight text-white">Agenda <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">AI</span></span>
    <% end %>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white pt-2">Crie sua conta em 1 minuto</h2>
    <p class="text-xs sm:text-sm text-slate-400">14 dias de teste gratuito • Sem necessidade de cartão para começar</p>
  </div>

  <div class="max-w-xl w-full p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl shadow-2xl space-y-6">
    <%= form_with(url: onboarding_index_path, method: :post, class: "space-y-6") do |f| %>

      <!-- Plan Selector Cards -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Selecione seu Plano Inicial</label>
        <div class="grid grid-cols-3 gap-2">
          <% @plans.each do |key, plan| %>
            <label class="relative flex flex-col justify-between p-3.5 rounded-2xl border cursor-pointer transition text-center hover:border-slate-600 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-600/10 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500 border-slate-800 bg-slate-950/60">
              <%= radio_button_tag "tenant[plan]", key, key == @selected_plan, class: "sr-only" %>
              <div>
                <span class="text-xs font-bold text-white block"><%= plan[:name] %></span>
                <span class="text-sm font-extrabold text-emerald-400 block mt-1">R$ <%= plan[:price_reais].round %></span>
              </div>
              <span class="text-[10px] text-slate-500 mt-2 block">
                <%= plan[:max_professionals] > 100 ? "Ilimitado" : "Até #{plan[:max_professionals]} prof." %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Business Information -->
      <div class="space-y-4 pt-2 border-t border-slate-800/80">
        <h3 class="text-xs font-bold text-indigo-400 uppercase tracking-wider">Dados do Estabelecimento</h3>

        <div>
          <%= label_tag "tenant[name]", "Nome do Estabelecimento / Salão *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
          <%= text_field_tag "tenant[name]", @tenant.name, required: true, autofocus: true, placeholder: "Ex: Barbearia Vip, Studio Beleza", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= label_tag "tenant[slug]", "Link / Subdomínio *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
            <div class="flex items-center">
              <span class="px-2.5 py-2.5 bg-slate-900 border border-r-0 border-slate-800 rounded-l-xl text-slate-500 text-[11px]">/</span>
              <%= text_field_tag "tenant[slug]", @tenant.slug, required: true, placeholder: "barbearia-vip", class: "w-full px-3 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-r-xl text-white text-xs outline-none font-mono" %>
            </div>
            <span class="text-[10px] text-slate-500 mt-1 block">Apenas letras minúsculas, números e hífens.</span>
          </div>

          <div>
            <%= label_tag "tenant[phone]", "Celular / WhatsApp", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
            <%= text_field_tag "tenant[phone]", @tenant.phone, placeholder: "(11) 98765-4321", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
          </div>
        </div>
      </div>

      <!-- Admin User Information -->
      <div class="space-y-4 pt-2 border-t border-slate-800/80">
        <h3 class="text-xs font-bold text-indigo-400 uppercase tracking-wider">Seus Dados de Acesso (Administrador)</h3>

        <div>
          <%= label_tag "user[name]", "Seu Nome Completo *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
          <%= text_field_tag "user[name]", @user.name, required: true, placeholder: "Ex: Carlos Silva", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div>
          <%= label_tag "user[email]", "Seu Email Profissional *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
          <%= email_field_tag "user[email]", @user.email, required: true, placeholder: "carlos@exemplo.com", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= label_tag "user[password]", "Senha *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
            <%= password_field_tag "user[password]", nil, required: true, placeholder: "Mínimo 6 caracteres", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
          </div>

          <div>
            <%= label_tag "user[password_confirmation]", "Confirmar Senha *", class: "block text-xs font-semibold text-slate-300 mb-1.5" %>
            <%= password_field_tag "user[password_confirmation]", nil, required: true, placeholder: "Repita a senha", class: "w-full px-4 py-2.5 bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl text-white text-xs outline-none" %>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Criar Minha Conta & Começar Grátis →", class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm shadow-xl shadow-indigo-600/30 transition transform hover:-translate-y-0.5 cursor-pointer" %>
      </div>

      <div class="text-center pt-2">
        <p class="text-xs text-slate-400">
          Já possui conta? <%= link_to "Entrar no Painel", new_user_session_path, class: "text-indigo-400 hover:text-indigo-300 font-semibold underline underline-offset-4" %>
        </p>
      </div>
    <% end %>
  </div>
</div>
