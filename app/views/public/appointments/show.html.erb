<% content_for :title, "Detalhes do Agendamento — #{@tenant.name}" %>

<div class="max-w-xl mx-auto space-y-6">
  <div class="text-center space-y-1">
    <h2 class="text-2xl font-extrabold text-white">Seu Agendamento</h2>
    <p class="text-xs text-slate-400">Consulte os detalhes ou cancele seu horário abaixo.</p>
  </div>

  <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-wider text-indigo-400 block">Estabelecimento</span>
        <h3 class="text-base font-bold text-white"><%= @tenant.name %></h3>
      </div>
      <span class="px-3 py-1 rounded-full text-xs font-semibold <%= @appointment.status_cancelled? ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
        <%= @appointment.status_cancelled? ? "Cancelado" : @appointment.status.capitalize %>
      </span>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div>
        <span class="text-slate-400 block">Serviço:</span>
        <strong class="text-white text-sm"><%= @appointment.service.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Profissional:</span>
        <strong class="text-white text-sm"><%= @appointment.professional.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Data:</span>
        <strong class="text-white text-sm"><%= @appointment.starts_at.strftime('%d/%m/%Y (%A)') %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Horário:</span>
        <strong class="text-indigo-400 text-sm"><%= @appointment.formatted_time %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Cliente:</span>
        <strong class="text-white text-sm"><%= @appointment.client.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Valor:</span>
        <strong class="text-emerald-400 text-sm"><%= @appointment.service.formatted_price %></strong>
      </div>
    </div>

    <% if @appointment.status_cancelled? %>
      <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs">
        <p class="font-bold">Agendamento Cancelado</p>
        <% if @appointment.cancellation_reason.present? %>
          <p class="mt-0.5 text-slate-300">Motivo: <%= @appointment.cancellation_reason %></p>
        <% end %>
      </div>
    <% else %>
      <!-- Cancel Form -->
      <div class="pt-4 border-t border-slate-800/80">
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Deseja cancelar o agendamento?</h4>
        <%= form_with(url: cancel_public_appointment_path(tenant_slug: @tenant.slug, id: @appointment.id), method: :patch, class: "space-y-3") do |f| %>
          <%= text_field_tag :reason, nil, placeholder: "Motivo do cancelamento (opcional)", class: "w-full px-3 py-2 bg-slate-950 border border-slate-800 focus:border-rose-500 rounded-xl text-white text-xs outline-none" %>

          <div class="flex items-center justify-between gap-3">
            <%= link_to "← Voltar ao Início", public_bookings_path(tenant_slug: @tenant.slug), class: "text-xs text-slate-400 hover:text-white transition" %>
            <%= f.submit "Confirmar Cancelamento", data: { turbo_confirm: "Tem certeza que deseja cancelar este agendamento?" }, class: "px-5 py-2 rounded-xl bg-rose-600/20 hover:bg-rose-600 text-rose-300 hover:text-white border border-rose-500/30 text-xs font-bold transition cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
