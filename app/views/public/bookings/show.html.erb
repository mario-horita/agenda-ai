<% content_for :title, "Agendamento Confirmado! — #{@tenant.name}" %>

<div class="max-w-xl mx-auto space-y-6">
  <!-- Success Icon & Title -->
  <div class="text-center space-y-2">
    <div class="w-16 h-16 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto shadow-xl shadow-emerald-500/20 animate-bounce">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Agendamento Confirmado!</h2>
    <p class="text-xs text-slate-400">Seu horário foi reservado com sucesso no estabelecimento.</p>
  </div>

  <!-- Booking Details Card -->
  <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-6 shadow-2xl">
    <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-wider text-indigo-400 block">Estabelecimento</span>
        <h3 class="text-base font-bold text-white"><%= @tenant.name %></h3>
      </div>
      <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
        <%= @appointment.status.capitalize %>
      </span>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div>
        <span class="text-slate-400 block">Serviço:</span>
        <strong class="text-white text-sm"><%= @appointment.service.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Profissional:</span>
        <strong class="text-white text-sm"><%= @appointment.professional.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Data:</span>
        <strong class="text-white text-sm"><%= @appointment.starts_at.strftime('%d/%m/%Y (%A)') %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Horário:</span>
        <strong class="text-indigo-400 text-sm"><%= @appointment.formatted_time %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Cliente:</span>
        <strong class="text-white text-sm"><%= @appointment.client.name %></strong>
      </div>
      <div>
        <span class="text-slate-400 block">Valor:</span>
        <strong class="text-emerald-400 text-sm"><%= @appointment.service.formatted_price %></strong>
      </div>
    </div>

    <!-- Actions -->
    <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row gap-3">
      <%= link_to public_appointment_path(tenant_slug: @tenant.slug, id: @appointment.id), class: "flex-1 py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-center text-xs font-semibold text-white transition" do %>
        Gerenciar / Cancelar Agendamento
      <% end %>

      <%= link_to public_bookings_path(tenant_slug: @tenant.slug), class: "py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-center text-xs font-bold text-white shadow-lg shadow-indigo-600/30 transition" do %>
        Novo Agendamento
      <% end %>
    </div>
  </div>
</div>
